# Paperproof environment variables.
# Copy this file to `.env` and fill in only the two keys:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
# Reflex loads `.env` automatically because `env_file=".env"` is set in rxconfig.py.

# ---------------------------------------------------------------------------
# Keys — these two are all you need to fill in.
# ---------------------------------------------------------------------------

# OpenRouter API key for grounded question answering.
# Without it, extraction and the citation audit still work, but asking a
# question returns a friendly "answer service is not configured" message.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API key for external context only.
# Leave blank and web search simply stays switched off. If set, Paperproof
# prefers Gemini's Google Search grounding for the opt-in "Include external
# context" toggle, and falls back to the OpenRouter web plugin if Gemini is
# unavailable. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Models — already chosen for you. Change only if you want something else.
# All of these are zero-cost. They are rate-limited and may be withdrawn, so
# Paperproof checks them against OpenRouter's live model list and reports an
# unavailable model instead of failing silently.
# ---------------------------------------------------------------------------

# Grounded answers, bibliography questions, and the fallback search path.
# Chosen by probing OpenRouter's zero-cost tier against a real key: a 120B
# mixture-of-experts with a 256k context window that advertises
# structured_outputs, so the answer contract is enforced with a real JSON
# schema rather than prompt wording alone.
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REFERENCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_WEB_SEARCH_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Verified zero-cost fallbacks, in order, if the default is ever withdrawn:
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   poolside/laguna-s-2.1:free
#   dots-studio/dots-3-note-preview:free

# Web search model. Leave blank for the default.
# GEMINI_SEARCH_MODEL=gemini-3.8-flash

# To hand model choice back to OpenRouter instead, set any model to:
#   OPENROUTER_TEXT_MODEL=openrouter/free
# Note that the router picks a random free model per request, so answer
# quality can vary between questions.

# There is deliberately no vision model (OPENROUTER_VISION_MODEL is unused):
# figures are read locally from OCR, caption, and nearby text, and image
# pixels are never sent to any external provider.

# ---------------------------------------------------------------------------
# Optional overrides — leave as they are unless you have a reason.
# ---------------------------------------------------------------------------

# Where figures extracted from an upload are stored. By default this is
# Reflex's uploaded-files directory, which the framework already serves at
# /_upload/, so no public URL is invented for session content. Each paper gets
# its own folder named after its internal paper id.
#
# Those folders are swept automatically: on page load, after every upload, and
# when a paper is removed, any folder without a paper still in the session is
# deleted. That keeps the session-only promise true on disk even after a restart.
# PAPERPROOF_MEDIA_DIR=.session_media

# Use npm (Node.js) instead of Bun for the frontend toolchain.
# Keep this set to 1: Reflex's bundled Bun mis-applies the `development`
# condition when launching the React Router dev CLI, which crashes dev mode.
# Set to 0 if you deliberately want Bun.
# The Dockerfile sets this to 1 too, so containers work without a .env.
REFLEX_USE_NPM=1

# Production needs nothing else. `render.yaml` supplies OPENROUTER_API_KEY as a
# Render env var, and the frontend and backend share one origin, so there is no
# api_url or CORS configuration to set.