# Paperproof environment variables.
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
# Reflex loads `.env` automatically because `env_file=".env"` is set in rxconfig.py.

# OpenRouter API key used for grounded question answering.
# Without it, the citation audit still works, but asking a question returns a
# friendly "answer service is not configured" message.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Use npm (Node.js) instead of Bun for the frontend toolchain.
# Keep this set to 1: Reflex's bundled Bun mis-applies the `development`
# condition when launching the React Router dev CLI, which crashes dev mode.
# Set to 0 if you deliberately want Bun.
# The Dockerfile sets this to 1 too, so containers work without a .env.
REFLEX_USE_NPM=1

# --- Deployment only (leave both unset for local development) ---------------

# Comma-separated exact origins allowed to call the backend's Socket.IO and HTTP
# endpoints. Only needed when the frontend is hosted on a different origin than
# the backend, e.g. the static frontend on Vercel and the backend on Render.
# A single-origin deployment (Render serving both) needs nothing here.
# REFLEX_CORS_ALLOWED_ORIGINS=https://paperproof.vercel.app

# Backend URL baked into the frontend bundle at export time. Reflex compiles the
# backend address into the built JavaScript, so this must be set in the build
# environment — not only at runtime — whenever the frontend is exported to a
# static host. Leave unset for the Render deployment: Reflex rewrites a localhost
# backend URL to whatever origin the page was served from.
# REFLEX_API_URL=https://paperproof.onrender.com
