# Caddy serves the exported static frontend and proxies the Reflex backend
# routes. TLS is terminated by Render, so this listens on plain HTTP on $PORT
# and never issues certificates.

{
	admin off
	auto_https off
}

:{$PORT}

encode gzip

# Content-hashed build assets never change under the same name.
@immutable path /assets/*
header @immutable Cache-Control "public, max-age=31536000, immutable"

@document path / /index.html /404.html /__spa-fallback.html /sitemap.xml /env.json
header @document Cache-Control "no-cache"

# Reflex backend endpoints: the Socket.IO event websocket plus its HTTP helpers.
# WebSocket upgrades are handled transparently by reverse_proxy.
@backend path /_event /_event/* /ping /_health /_upload /_upload/* /_all_routes
handle @backend {
	reverse_proxy 127.0.0.1:8000
}

root * /srv

route {
	# 404.html is the exported SPA fallback: React Router boots from it, so any
	# unmatched path still renders the app instead of a bare error page.
	try_files {path} {path}/ /404.html
	file_server {
		# reflex export writes pre-compressed copies of the text assets.
		precompressed br zstd gzip
	}
}
